# Gemini API runs on the server only.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="YOUR_APP_URL"

# Supabase browser configuration.
# Publishable keys are intended for browser use when RLS is enabled.
# NEVER put a service_role or secret key in a VITE_* variable.
VITE_SUPABASE_URL="https://qjqgekxbknnrnuppfwag.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Server-only. Keep this secret out of frontend build variables and source control.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional model cost rates in USD per 1M tokens. Leave at 0 until verified for the selected model.
GEMINI_INPUT_COST_PER_1M_USD="0"
GEMINI_OUTPUT_COST_PER_1M_USD="0"
